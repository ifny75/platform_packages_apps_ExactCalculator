<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@color/display_background_color">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.32" android:orientation="vertical">
        <include layout="@layout/display_modern" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:paddingHorizontal="8dp">
            <ImageButton android:id="@+id/show_history" style="@style/ModernAction" android:src="@drawable/ic_key_history" android:contentDescription="@string/menu_history" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/del" style="@style/ModernAction" android:src="@drawable/ic_key_delete" android:contentDescription="@string/desc_del" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.32" android:padding="8dp">
        <include layout="@layout/pad_scientific" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.36" android:orientation="vertical" android:gravity="center" android:paddingVertical="4dp">
        <include layout="@layout/pad_modern" />
    </LinearLayout>
</LinearLayout>
