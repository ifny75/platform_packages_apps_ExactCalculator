<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical" android:background="@color/display_background_color">
    <include layout="@layout/display_modern" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:paddingHorizontal="6dp"
        android:orientation="horizontal" android:background="@color/pad_numeric_background_color">
        <ImageButton android:id="@+id/show_history" style="@style/ModernAction" android:src="@drawable/ic_key_history" android:contentDescription="@string/menu_history" />
        <ImageButton android:id="@+id/show_scientific" style="@style/ModernAction" android:src="@drawable/ic_key_expand" android:contentDescription="@string/desc_scientific" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton android:id="@+id/del" style="@style/ModernAction" android:src="@drawable/ic_key_delete" android:contentDescription="@string/desc_del" />
    </LinearLayout>
    <com.android.calculator2.CalculatorPadViewPager android:id="@+id/pad_pager" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1.25" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/pad_numeric_background_color">
            <include layout="@layout/pad_modern" />
        </LinearLayout>
        <include layout="@layout/pad_scientific" />
    </com.android.calculator2.CalculatorPadViewPager>
</LinearLayout>
