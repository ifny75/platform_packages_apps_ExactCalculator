<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ModernKey" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/key_numeric</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/pad_button_text_color</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">32sp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:onClick">onButtonClick</item>
    </style>
    <style name="ModernKey.Utility"><item name="android:background">@drawable/key_utility</item></style>
    <style name="ModernKey.Accent">
        <item name="android:background">@drawable/key_accent</item>
        <item name="android:textColor">@color/key_on_accent</item>
    </style>
    <style name="ModernAction" parent="@android:style/Widget.Material.ImageButton">
        <item name="android:background">@drawable/action_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:tint">@color/calculator_accent_color</item>
        <item name="android:onClick">onButtonClick</item>
    </style>
    <style name="ScienceKey" parent="ModernKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="layout_gravity">fill</item>
        <item name="layout_rowWeight">1</item>
        <item name="layout_columnWeight">1</item>
        <item name="android:background">@drawable/key_scientific</item>
        <item name="android:textColor">@color/pad_button_text_color</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">20sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:paddingHorizontal">4dp</item>
    </style>
    <style name="ScienceKey.Toggle">
        <item name="android:textColor">@color/scientific_text</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
